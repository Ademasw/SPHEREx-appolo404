# Backend connection settings (Vite exposes variables prefixed with VITE_).
# Copy this file to `.env.local` when connecting your backend server.

# Base HTTP URL of the backend (leave empty to use local placeholder media).
# Example: http://localhost:8000
VITE_API_BASE_URL=

# Optional real-time push protocol for streaming updates into the media windows.
# Supported values: none | sse | ws
VITE_STREAM_MODE=none

